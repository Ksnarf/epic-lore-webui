# Environment / secrets - never commit a real .env
.env
.env.*
!.env.example

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Logs - internal process logs (operator names, local filesystem paths)
# must never land in this public repo; keep them out entirely.
/logs/
*.log
/log.log

# Local working notes. Never committed - this repository is public.
.local-notes/

# Node / pnpm
node_modules/
.pnpm-store/

# Build output
dist/
build/
apps/web/dist/
apps/bff/dist/

# buf-generated gRPC clients (packages/lore-client) - generate-on-build,
# not committed. See packages/lore-client/buf.gen.yaml + `pnpm run generate`.
packages/lore-client/src/gen/

# TS build info
*.tsbuildinfo
